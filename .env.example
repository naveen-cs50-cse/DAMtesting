# ==========================================
# DAM AI — Environment Configuration & API Keys
# ==========================================

# 1. AI Reasoning & Challenger Models
# (Choose at least one provider)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Preferred Model Selection
DAM_MODEL_PRIMARY=gpt-4o
DAM_MODEL_CHALLENGER=gpt-4o-mini

# 2. Live Web Search & Registry Verification
# Used for real-time querying against Indian registries (rbi.org.in, pib.gov.in, trai.gov.in)
TAVILY_API_KEY=tvly-your-tavily-api-key-here
# Or Serper:
SERPER_API_KEY=your-serper-api-key-here

# 3. Backend & Database (Optional / Future Multi-tenant)
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 4. Regional Indian Language Support (Optional)
# BHASHINI_API_KEY=your-bhashini-api-key-here

# 5. Published Integration Destinations (Optional)
# International-format WhatsApp business number; punctuation is accepted and normalized server-side.
DAM_WHATSAPP_BOT_NUMBER=
# Exact published Chrome Web Store detail URL, including the 32-character extension ID.
DAM_CHROME_EXTENSION_URL=
